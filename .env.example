VITE_AI_PROVIDER=openrouter

# Existing Vercel variable names are intentionally preserved.
# The provider API keys below are now read ONLY by Vercel server functions.
# Browser code no longer reads or bundles the secret values.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.1-8b-instant

VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openai/gpt-4.1

VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# Supabase publishable values are expected to be available to browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only bridge to the authenticated GCP Stockfish service.
# MCP_AUTH_TOKEN must match the token already configured in the chess-mcp Cloud Run service.
MCP_AUTH_TOKEN=
CHESS_MCP_URL=https://chatgpt-stockfish-567370443508.us-central1.run.app
