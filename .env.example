VITE_AI_PROVIDER=disabled

# Optional browser-side provider settings.
# These are exposed to the client bundle. For real production use,
# move LLM requests behind a server-side proxy and rotate any keys
# that were ever pasted into chat or committed.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.1-8b-instant

VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini

VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-1.5-flash
